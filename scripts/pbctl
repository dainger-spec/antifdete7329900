#!/usr/bin/env python3
"""pbctl — the Lumen automation API from the command line (docs/AUTOMATION_API.md).

    pbctl list
    pbctl create [--name N] [--proxy socks5://user:pass@host:port] [--keep] [--start] [--hidden]
    pbctl show <profile>
    pbctl start <profile> [--hidden]
    pbctl stop <profile>
    pbctl open <profile> <url>
    pbctl cookies <profile> [--format playwright|netscape|extension]
    pbctl import-cookies <profile> <file>
    pbctl webdriver <profile>
    pbctl run <profile> (--scenario NAME | --file SCRIPT.js | --source TEXT) [--param name=value]… [--wait [SECONDS]]
    pbctl log <profile>
    pbctl stop-run <profile>

`run` starts a scenario on a running profile: a saved one by its name (with the profile's own values
for scenarios in params, --param over them), or a text. With --wait it follows the run to its end,
prints its log and its result, and exits 1 unless the run finished.

<profile> is a profile's id or its exact name. The token comes from PB_API_TOKEN (Automation API…
→ Copy in the app), the port from PB_API_PORT (default 50777). Nothing is installed: Python 3 only.
"""
import argparse
import base64
import hashlib
import hmac
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request


def api_token():
    token = os.environ.get("PB_API_TOKEN", "")
    if not token:
        sys.exit("pbctl: set PB_API_TOKEN to the token shown in the app (Automation API… → Copy)")
    return token


def api_port():
    return int(os.environ.get("PB_API_PORT", "50777"))


def webdriver_token(token, profile_id):
    """A profile's own WebDriver token (WebDriverRoute.token, docs/AUTOMATION.md "WebDriver"):
    base64url without padding of HMAC-SHA256(key = the API's token, "webdriver:" + its UUID)."""
    mac = hmac.new(token.encode(), ("webdriver:" + profile_id.upper()).encode(), hashlib.sha256).digest()
    return base64.urlsafe_b64encode(mac).decode().rstrip("=")


def print_run(state, since=0):
    """A run's log lines from `since` on, each after the seconds since the run started; how many there are."""
    started = state.get("startedAt", "")
    lines = state.get("lines", [])
    for line in lines[since:]:
        mark = "!" if line.get("kind") == "error" else " "
        print(f'{seconds_between(started, line.get("at", "")):8.1f} {mark} {line.get("text", "")}', flush=True)
    return len(lines)


def seconds_between(start, end):
    """Seconds from one of the API's times (ISO 8601, UTC) to another; 0 for what is not one."""
    def parse(text):
        return time.mktime(time.strptime(text, "%Y-%m-%dT%H:%M:%SZ"))
    try:
        return max(0.0, parse(end) - parse(start))
    except (TypeError, ValueError):
        return 0.0


def call(method, path, body=None, raw=False):
    token = api_token()
    port = api_port()
    data = body if isinstance(body, (bytes, type(None))) else json.dumps(body).encode()
    request = urllib.request.Request(f"http://127.0.0.1:{port}{path}", data=data, method=method,
                                     headers={"Authorization": f"Bearer {token}"})
    # Straight to 127.0.0.1, never through a proxy set in the environment.
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(request, timeout=180) as response:
            payload = response.read()
    except urllib.error.HTTPError as error:
        payload = error.read()
        try:
            message = json.loads(payload).get("message", "")
        except ValueError:
            message = payload.decode(errors="replace")
        sys.exit(f"pbctl: {error.code}: {message}")
    except urllib.error.URLError as error:
        sys.exit(f"pbctl: the API does not answer on 127.0.0.1:{port} ({error.reason}); is it on and the vault unlocked?")
    return payload if raw else json.loads(payload)


def profile_path(reference, suffix=""):
    return "/v1/profiles/" + urllib.parse.quote(reference, safe="") + suffix


def main():
    parser = argparse.ArgumentParser(prog="pbctl", description=__doc__.split("\n\n")[0])
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("list", help="every profile")
    create = commands.add_parser("create", help="make a profile — temporary unless --keep — and start it with --start")
    create.add_argument("--name")
    create.add_argument("--proxy", help="scheme://user:password@host:port (socks5, http or https)")
    create.add_argument("--keep", action="store_true", help="a profile that keeps its data, not a temporary one")
    create.add_argument("--start", action="store_true", help="start it at once")
    create.add_argument("--hidden", action="store_true", help="with --start: without a window, as a warm-up does")
    for name, help_text in (("show", "one profile"), ("stop", "stop a profile (its data is sealed)")):
        commands.add_parser(name, help=help_text).add_argument("profile")
    start = commands.add_parser("start", help="start a profile")
    start.add_argument("profile")
    start.add_argument("--hidden", action="store_true", help="without a window, as a warm-up does")
    open_ = commands.add_parser("open", help="a new window of a running profile on a URL")
    open_.add_argument("profile")
    open_.add_argument("url")
    cookies = commands.add_parser("cookies", help="a profile's cookies, to stdout")
    cookies.add_argument("profile")
    cookies.add_argument("--format", choices=("playwright", "netscape", "extension"), default="playwright")
    imports = commands.add_parser("import-cookies", help="import a cookie file into a profile")
    imports.add_argument("profile")
    imports.add_argument("file")
    commands.add_parser("webdriver", help="a profile's WebDriver address (for Selenium's command_executor)").add_argument("profile")
    run = commands.add_parser("run", help="run a scenario on a running profile: a saved one by name, or a text")
    run.add_argument("profile")
    what = run.add_mutually_exclusive_group(required=True)
    what.add_argument("--scenario", help="a saved scenario's exact name (its params: the profile's own values, --param over them)")
    what.add_argument("--file", help="a file of the scenario's JavaScript")
    what.add_argument("--source", help="the scenario's JavaScript")
    run.add_argument("--param", action="append", default=[], metavar="name=value", help="a value for params (text); may be given several times")
    run.add_argument("--wait", nargs="?", type=float, const=3600.0, default=None, metavar="SECONDS",
                     help="follow the run to its end (an hour at most unless SECONDS is given), print its log and result; exit 1 unless it finished")
    commands.add_parser("log", help="a profile's last run: its log, how it ended, its result").add_argument("profile")
    commands.add_parser("stop-run", help="stop a profile's run").add_argument("profile")
    args = parser.parse_args()

    if args.command == "list":
        for profile in call("GET", "/v1/profiles"):
            state = "running" if profile["running"] else ("busy" if profile["busy"] else "stopped")
            print(f'{profile["id"]}  {state:8}  {profile.get("proxy") or "direct":32}  {profile["name"]}')
    elif args.command == "create":
        body = {"temporary": not args.keep, "start": args.start, "window": not args.hidden}
        if args.name:
            body["name"] = args.name
        if args.proxy:
            body["proxy"] = args.proxy
        print(json.dumps(call("POST", "/v1/profiles", body), indent=2, ensure_ascii=False))
    elif args.command == "show":
        print(json.dumps(call("GET", profile_path(args.profile)), indent=2, ensure_ascii=False))
    elif args.command == "start":
        print(json.dumps(call("POST", profile_path(args.profile, "/start"), {"window": not args.hidden}), indent=2, ensure_ascii=False))
    elif args.command == "stop":
        print(json.dumps(call("POST", profile_path(args.profile, "/stop"), {}), indent=2, ensure_ascii=False))
    elif args.command == "open":
        print(json.dumps(call("POST", profile_path(args.profile, "/open"), {"url": args.url}), indent=2, ensure_ascii=False))
    elif args.command == "cookies":
        sys.stdout.buffer.write(call("GET", profile_path(args.profile, f"/cookies?format={args.format}"), raw=True))
    elif args.command == "import-cookies":
        with open(args.file, "rb") as handle:
            print(json.dumps(call("POST", profile_path(args.profile, "/cookies"), handle.read()), indent=2))
    elif args.command == "webdriver":
        profile_id = call("GET", profile_path(args.profile))["id"]
        print(f"http://127.0.0.1:{api_port()}/wd/{webdriver_token(api_token(), profile_id)}/{profile_id.upper()}")
    elif args.command == "run":
        params = {}
        for pair in args.param:
            name, separator, value = pair.partition("=")
            if not separator or not name:
                sys.exit(f"pbctl: --param takes name=value, not {pair!r}")
            params[name] = value
        if args.scenario:
            body = {"scenario": args.scenario}
        elif args.file:
            with open(args.file, encoding="utf-8") as handle:
                body = {"source": handle.read()}
        else:
            body = {"source": args.source}
        if params:
            body["params"] = params
        started = call("POST", profile_path(args.profile, "/scenario"), body)
        if args.wait is None:
            print(json.dumps(started, indent=2))
            return
        # The run's log as it grows, then how it ended.
        shown, deadline = 0, time.monotonic() + max(args.wait, 0)
        while True:
            state = call("GET", profile_path(args.profile, "/scenario"))
            if state.get("runID") != started.get("runID"):
                sys.exit("pbctl: another run of this profile took this one's place")
            shown = print_run(state, shown)
            if not state.get("running"):
                break
            if time.monotonic() >= deadline:
                sys.exit(f"pbctl: the run is still going after {args.wait:g} s (pbctl stop-run stops it)")
            time.sleep(0.5)
        if "result" in state:
            print(json.dumps(state["result"], indent=2, ensure_ascii=False))
        if state.get("outcome") != "finished":
            sys.exit(f'pbctl: the run {state.get("outcome")}: {state.get("reason") or ""}'.rstrip(": "))
    elif args.command == "log":
        state = call("GET", profile_path(args.profile, "/scenario"))
        print_run(state)
        print("running" if state.get("running") else f'{state.get("outcome")}{": " + state["reason"] if state.get("reason") else ""}')
        if "result" in state:
            print(json.dumps(state["result"], indent=2, ensure_ascii=False))
    elif args.command == "stop-run":
        print(json.dumps(call("POST", profile_path(args.profile, "/scenario/stop"), {}), indent=2))


if __name__ == "__main__":
    main()
