<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets this extension act as a packet-tunnel provider. Requires a provisioning profile
	     from a paid Apple Developer account; ad-hoc signing cannot grant it. -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<!-- Shared with the container app so the proxy password can be handed over via a keychain
	     persistent reference. Replace the group id to match your team. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(APP_GROUP)</string>
	</array>
</dict>
</plist>
