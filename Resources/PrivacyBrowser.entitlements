<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox (default build). Every entitlement below is required; see
	     docs/ISOLATION_AND_LIMITATIONS.md §7 for what each one is used for. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- WKWebView networking (WebKit's network process acts on the app's behalf) and sync. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- "What sites see" (SiteSnapshotServer): a listener on 127.0.0.1 only, only while a snapshot
	     is taken, that the measuring page in the profile's window and in Safari reports to. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- getUserMedia, only after the per-request in-app prompt. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- <input type=file> uploads and choosing the sync folder (NSOpenPanel / Powerbox). -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Downloads are saved to ~/Downloads. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- Remember the chosen sync folder across launches (security-scoped bookmark). -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Updates (docs/UPDATES.md §3): the one folder outside the container the app may write,
	     where it stages a checked update for the installer helper. The helper runs outside the
	     sandbox; this way it never reads inside the app's container. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/Caches/$(BUNDLE_ID).update/</string>
	</array>
</dict>
</plist>
