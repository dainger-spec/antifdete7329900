<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- Russian is the default UI language (see Localization.swift); English is the fallback. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ru</string>
		<string>en</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>PrivacyBrowser</string>
	<key>CFBundleIdentifier</key>
	<string>$(BUNDLE_ID)</string>
	<key>CFBundleName</key>
	<string>PrivacyBrowser</string>
	<key>CFBundleDisplayName</key>
	<string>PrivacyBrowser</string>
	<!-- Contents/Resources/AppIcon.icns, drawn by the app at build time (scripts/build-app.sh). -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<!-- Shown when a site calls getUserMedia and the user allows it in the in-app prompt. -->
	<key>NSCameraUsageDescription</key>
	<string>A website you are visiting requested access to the camera.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>A website you are visiting requested access to the microphone.</string>
	<!-- A browser must load http:// pages. This relaxes App Transport Security for WKWebView
	     content only; the app's own URLSession traffic (HTTP sync transport) stays HTTPS-only. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<!-- The self-test's stand-in geolocation service, answered by scripts/selftest_proxy.py
		     over plain HTTP. ".invalid" never resolves on a real network (RFC 6761). -->
		<key>NSExceptionDomains</key>
		<dict>
			<key>selftest.invalid</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<!-- Deliberately no NSLocationUsageDescription: the app never uses CoreLocation.
	     Geolocation is answered by the per-profile JavaScript shim (deny or fixed coordinates). -->
</dict>
</plist>
