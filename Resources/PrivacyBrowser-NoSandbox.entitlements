<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime without App Sandbox (SANDBOX=0 builds): the build that is released
	     (scripts/release.sh, docs/UPDATES.md §6). Under the hardened runtime, camera/microphone
	     access still needs these. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- No relaxation of the hardened runtime here: the app's own executable (Contents/MacOS/Lumen)
	     keeps library validation on. Safari's private frameworks (SafariChrome.swift) load only in
	     Contents/MacOS/LumenProfile, which scripts/build-app.sh signs with these and
	     com.apple.security.cs.disable-library-validation besides (docs/SAFARI_PROCESS.md §9.1). In a
	     build with the network guard the app's executable holds the network extension's right, and
	     beside it the kernel kills an executable holding library validation off at its start
	     (measured on macOS 27.0.1, 3 November: docs/TUNNEL.md; scripts/relaxation_check.sh). -->
</dict>
</plist>
