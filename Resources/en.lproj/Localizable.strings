"help.keys.lock" = "Lock: stops every profile, encrypts its data and forgets the keys. While profiles run it asks first.";
"help.keys.quit" = "Quit, encrypting every profile";
"help.keys.window" = "In a profile’s window";
"help.keys.window.note" = "Safari’s window has Safari’s own shortcuts; these are for Lumen’s own window.";
"help.keys.newTab" = "A new tab";
"help.keys.reopenTab" = "Reopen the closed tab";
"help.keys.address" = "The address field";
"help.keys.reload" = "Reload the page";
"help.keys.backForward" = "Back and forward";
"help.keys.tabs" = "The next and the previous tab";
"help.keys.tabNumber" = "A tab by its number; ⌘9 is the last";
