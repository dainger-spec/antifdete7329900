"help.palette.intro" = "The command palette is the shortest way to anything in Lumen. Open it with ⌘K, or with Commands and Search on the left of the Profiles window, and start typing.";
"help.palette.finds" = "What it finds";
"help.palette.finds.profiles" = "Profiles, by name, tags and where they exit: launch, stop, open a new window, edit, warm up, see what websites see.";
"help.palette.finds.actions" = "Actions: a new profile, the proxies, the warm-up queue, sync, Lock, the scenarios, the automation API, Help.";
"help.palette.finds.settings" = "The sections of Settings, by name.";
"help.palette.finds.report" = "Copy Short Report: the diagnostics as one text, on the clipboard.";
"help.palette.keys" = "Keys";
"help.palette.key.choose" = "Choose a row";
"help.palette.key.run" = "Run the chosen one";
"help.palette.key.close" = "Close the palette";
"help.scenarios.intro" = "A scenario is JavaScript that does in a profile what a person would: goes to pages, clicks, types, waits. Lumen moves the pointer and presses the keys itself, with no debugging protocol: the page gets mouse and keyboard events.";
"help.scenarios.plan" = "Running scenarios is part of the Professional and Team plans, and of the trial. On Personal, scenarios can be written, not run.";
"help.scenarios.how" = "How to run a scenario";
"help.scenarios.step.open" = "Open Scenarios: on the left of the Profiles window, in the File menu, or with ⇧⌘E.";
"help.scenarios.step.new" = "Click New Scenario: it comes with an example that works.";
"help.scenarios.step.write" = "Name the scenario and write its steps. ⌘S saves.";
"help.scenarios.step.run" = "Choose a profile and click Run (⌘R). Lumen starts a stopped profile itself.";
"help.scenarios.step.log" = "Follow the log under the code: every command with its time, errors in red. Stop ends the run; a command under way finishes first.";
"help.scenarios.example" = "An example: signing in";
"help.scenarios.example.code" = "await page.goto('https://shop.example/login');\nawait page.type('#email', 'name@example.com');\nawait page.type('#password', 'your password');\nawait page.press('Enter');\nawait page.waitFor('text=My orders');\nlog('Signed in:', await page.title());";
"help.scenarios.know" = "Worth knowing";
"help.scenarios.know.window" = "A scenario runs in a window of Safari’s that Lumen opens for the run: the profile’s real window, with its cookies and proxy. A profile seen as an iPhone or iPad has no Safari window: its scenario runs in Lumen’s own.";
"help.scenarios.know.await" = "Every command of page waits for the page and returns a promise: write await before it.";
"help.scenarios.know.errors" = "A command that fails throws an error with the reason. try and catch can catch it; one left uncaught ends the run.";
"help.scenarios.know.typed" = "The log says how many characters were typed, never which: no password is in it.";
"help.scenarios.know.kept" = "Scenarios are kept in the vault on this Mac, encrypted. They are not synced.";
"help.commands.intro" = "The commands belong to page. A selector is CSS (#login, .buy, input[name=q]) or text=…, the smallest visible element holding that text. Options go last, in braces, such as {timeout: 30000}, in milliseconds.";
"help.commands.navigation" = "Going to pages";
"help.commands.goto" = "Goes to an http or https address, as the address bar does, and waits for the page. {waitUntil: 'domcontentloaded'} does not wait for pictures and styles.";
"help.commands.history" = "Back, forward, reload, as the toolbar’s buttons; they wait for the page.";
"help.commands.loadState" = "Waits for the page’s state: 'load' or 'domcontentloaded'.";
"help.commands.waiting" = "Waiting";
"help.commands.waitFor" = "Waits for an element. {state: 'visible'} by default; also 'hidden', 'attached', 'detached'. Not there within the timeout is an error.";
"help.commands.sleep" = "A pause, in milliseconds.";
"help.commands.acting" = "Acting";
"help.commands.click" = "Waits for the element, scrolls it into view with the wheel, moves the pointer onto it and clicks. An element covered by another is an error naming what covers it.";
"help.commands.dblclick" = "A double click. The same as page.click(selector, {clickCount: 2}).";
"help.commands.hover" = "Moves the pointer onto the element.";
"help.commands.type" = "Clicks the field and types the text key by key. {delay: 120} is the pause between keys, about that many milliseconds.";
"help.commands.press" = "A key or a combination: 'Tab', 'Shift+Tab', 'Meta+a'.";
"help.commands.scroll" = "Scrolls with the wheel that many points down; a negative number scrolls up.";
"help.commands.reading" = "Reading the page";
"help.commands.text" = "The element’s text.";
"help.commands.inputValue" = "What a field holds.";
"help.commands.getAttribute" = "An attribute’s value, href for one.";
"help.commands.count" = "How many elements the selector finds.";
"help.commands.isVisible" = "Whether the element shows: true or false.";
"help.commands.url" = "The page’s address and title.";
"help.commands.evaluate" = "Runs a function on the page and gives its result. It runs in a world of its own, which the page’s scripts cannot see.";
"help.commands.screenshot" = "A picture of the part of the page in view, or of an element with page.screenshot(selector). The result is a PNG in base64.";
"help.commands.script" = "In the scenario itself";
"help.commands.log" = "A line in the run’s log.";
"help.commands.params" = "The run’s parameters, when the scenario is run through the automation API; empty otherwise.";
"help.api.intro" = "A script on this Mac can do what the Profiles window does: list the profiles, start and stop one, open a page in it, read and write its cookies, run a scenario. It connects only from this Mac (127.0.0.1) and only with the token.";
"help.api.plan" = "The API is part of the Professional and Team plans, and of the trial. Without it every request is refused with 403 automation_not_in_plan.";
"help.api.on" = "Turning it on";
"help.api.step.open" = "Open Automation API on the left of the Profiles window, or the section of that name in Settings.";
"help.api.step.enable" = "Turn on “Let scripts on this Mac drive the profiles”.";
"help.api.step.token" = "Copy the token. The port is 50777 unless you change it there.";
"help.api.step.unlocked" = "The API answers while the vault is unlocked.";
"help.api.try" = "Trying it in Terminal";
"help.api.try.code" = "export PB_API_TOKEN='the token from Automation API'\ncurl -s -H \"Authorization: Bearer $PB_API_TOKEN\" http://127.0.0.1:50777/v1/profiles";
"help.api.requests" = "Requests";
"help.api.request.list" = "Every profile.";
"help.api.request.one" = "One profile. {profile} is its id or its exact name, encoded for an address. A name two profiles share is refused: use the id.";
"help.api.request.start" = "Starts it. The body {\"window\": false} starts it without a window. A running profile is left as it is.";
"help.api.request.stop" = "Stops it. The profile’s data is encrypted before the answer comes.";
"help.api.request.open" = "A new window of the running profile at the body’s address: {\"url\": \"https://…\"}.";
"help.api.request.cookies" = "Every cookie of the profile. ?format=playwright (the default), netscape or extension.";
"help.api.request.importCookies" = "Imports the cookies in the body: a JSON or a Netscape file.";
"help.api.request.scenario" = "Runs a scenario on the running profile: {\"source\": \"…\", \"params\": {…}}, or a saved one, {\"scenario\": \"Its name\"}.";
"help.api.request.scenarioState" = "The profile’s last run: whether it is running, how it ended, its log.";
"help.api.request.scenarioStop" = "Stops the run: a command under way finishes first.";
"help.api.scenario" = "A scenario from a script";
"help.api.scenario.code" = "curl -s -X POST -H \"Authorization: Bearer $PB_API_TOKEN\" -d '{\"source\": \"await page.goto(params.url); log(await page.title());\", \"params\": {\"url\": \"https://example.com/\"}}' http://127.0.0.1:50777/v1/profiles/Shop/scenario";
"help.api.errors" = "Errors";
"help.api.errors.text" = "An error comes as {\"error\": \"code\", \"message\": \"text\"}. 401: no token, or a wrong one. 403 automation_not_in_plan: the plan has no automation. 404: no such profile. 409: two profiles share the name (ambiguous), the profile is not running (not_running) or is busy (busy).";
"help.api.token" = "Whoever has the token can start your profiles and read their cookies. Show it to no one; New Token, in the same window, ends the old one at once.";
"help.keys.app" = "In the Profiles window";
"help.keys.palette" = "The command palette";
