/* Help: the virtual camera */
"help.topic.camera" = "Virtual Camera";
"help.camera.intro" = "A profile can hand a page a camera of your choosing instead of this Mac's, when the page asks for one with getUserMedia. You set it per profile in the editor's Camera part.";
"help.camera.turnOn" = "Turning it on";
"help.camera.step.edit" = "Open a profile's settings and go to Camera.";
"help.camera.step.mode" = "Pick Substitute (or No camera to hide it, Real camera to leave it).";
"help.camera.step.source" = "Choose what it shows: a colour, a test pattern, an image or a video.";
"help.camera.step.tune" = "Set the resolution, frame rate, device name and microphone.";
"help.camera.step.save" = "Save. The next time the profile's pages ask for the camera, they get yours.";
"help.camera.sources" = "What it can show";
"help.camera.source.color" = "Solid colour — a plain frame in the colour you pick.";
"help.camera.source.bars" = "Test pattern — colour bars with a moving bar and a running clock.";
"help.camera.source.image" = "Image — a photo you choose, drawn in every frame.";
"help.camera.source.video" = "Video — a clip you choose, looped.";
"help.camera.tuning" = "What you can tune";
"help.camera.tune.resolution" = "Resolution and frame rate the page is told and the stream is drawn at.";
"help.camera.tune.label" = "The device name the page reads from the camera list.";
"help.camera.tune.audio" = "The microphone: the real one, a silent track, or none.";
"help.camera.tune.mirror" = "Mirror the picture, and how the source fits the frame.";
"help.camera.tune.screen" = "Whether screen sharing gets the same stream.";
"help.camera.know" = "Worth knowing";
"help.camera.secure" = "The camera API exists only in a secure context: a page over plain http on a public address has none to substitute, as in any browser.";
"help.camera.know.safari" = "It works in the real Safari window as well as the app's own.";
"help.camera.know.detect" = "The frames are drawn, not from a sensor: a check that looks for a live camera can still tell.";
"help.camera.know.permission" = "A page still asks you for the camera the first time, as before.";
"help.camera.know.size" = "An image or video is kept with the profile and synced, so keep it small.";
"help.camera.know.system" = "Delivery: the JavaScript shim draws the frames, or the system camera (if installed) feeds them through macOS, so a page cannot tell it from the built-in camera.";

