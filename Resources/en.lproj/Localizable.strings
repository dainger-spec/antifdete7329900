/* Help: the virtual camera */
"help.topic.camera" = "Virtual Camera";
"help.camera.intro" = "A profile can hand a page a camera of your choosing instead of this Mac's, when the page asks for one with getUserMedia. You set it per profile in the editor's Camera part.";
"help.camera.plan" = "Camera substitution is part of the Pro and Team plans. On a lower plan the Camera settings are unavailable and a profile's camera stays off.";
"help.camera.turnOn" = "Turning it on";
"help.camera.step.edit" = "Open a profile's settings and go to Camera.";
"help.camera.step.mode" = "Pick Substitute (or No camera to hide it, Real camera to leave it).";
"help.camera.step.source" = "Choose what it shows: a colour, a test pattern, an image or a video.";
"help.camera.step.tune" = "Set the resolution, frame rate, device name and microphone.";
"help.camera.step.save" = "Save. The next time the profile's pages ask for the camera, they get yours.";
"help.camera.sources" = "What it can show";
"help.camera.source.color" = "Solid colour — a plain frame in the colour you pick.";
"help.camera.source.bars" = "Test pattern — colour bars with a moving bar and a running clock.";
"help.camera.source.image" = "Image — a photo you choose, drawn in every frame.";
"help.camera.source.video" = "Video — a clip you choose, looped.";
"help.camera.tuning" = "What you can tune";
"help.camera.tune.resolution" = "Resolution and frame rate the page is told and the stream is drawn at (the JavaScript shim; the system camera offers a built-in camera’s sizes and the page picks).";
"help.camera.tune.label" = "The device name the page reads from the camera list.";
"help.camera.tune.audio" = "The microphone: the real one, a silent track, or none (the JavaScript shim; with the system camera it is as in Safari).";
"help.camera.tune.mirror" = "Mirror the picture, and how the source fits the frame.";
"help.camera.tune.screen" = "Whether screen sharing gets the same stream (the JavaScript shim).";
"help.camera.know" = "Worth knowing";
"help.camera.secure" = "The camera API exists only in a secure context: a page over plain http on a public address has none to substitute, as in any browser.";
"help.camera.know.safari" = "It works in the real Safari window as well as the app's own.";
"help.camera.know.detect" = "The frames are drawn, not from a sensor: a check that looks for a live camera can still tell.";
"help.camera.know.permission" = "A page still asks you for the camera the first time, as before.";
"help.camera.know.size" = "An image or video is kept in the profile's settings and synced with them, so it is kept small: an image up to 4 MB, the image and the video together about 6 MB; a larger file is refused. A profile that holds more from an earlier version works as before, but its settings do not sync until you choose a smaller video or image.";
"help.camera.know.system" = "Delivery: the JavaScript shim draws the frames, or the system camera (if installed) feeds them through macOS, so a page cannot tell it from the built-in camera.";
"help.camera.know.systemInstall" = "The system camera is installed once: Camera → System camera → Install…, then switch on “Media extension” for Lumen in System Settings → General → Login Items & Extensions. Until it is on, a profile set to it gets no camera and cannot be saved with it; after an app update Lumen replaces it by itself.";
"help.topic.warmUp" = "Warm-Up";
"help.warmUp.intro" = "Warm-up gives a new profile a browsing past before you use it: it visits ordinary sites through the profile's own proxy, with its cookies, language and Safari, so that it arrives at the site you need with history and cookies like anyone's.";
"help.warmUp.start" = "Warming a profile up";
"help.warmUp.step.open" = "Open Warm-up in the sidebar and press New warm-up — or choose Warm Up… in a profile's ⋯ menu, or for a selection of profiles.";
"help.warmUp.step.choose" = "Tick the templates: kinds of browsing (an ordinary day, news, shopping…) and lists of your own. Each profile gets the sites of the country its proxy exits in; the right side shows a sample.";
"help.warmUp.step.depth" = "Choose Light, Normal or Deep: how many sites, how many pages on each and about how long.";
"help.warmUp.step.start" = "Press Start warm-up. Stopped profiles start without a window and take turns; the Warm-up section shows each one's progress.";
"help.warmUp.how" = "What it does on a page";
"help.warmUp.how.pages" = "Reads a page for as long as its text and height take, scrolls in bursts with pauses, moves the pointer as a hand does, and pauses between sites.";
"help.warmUp.how.search" = "Reaches part of the sites through the profile's search engine: types the site's name key by key and follows its result. When that cannot be done, it opens the address.";
"help.warmUp.how.links" = "Follows links in a page's main part — headlines first — and sometimes goes back for another. Never sign-in, account, sign-out, purchase, download or new-window links.";
"help.warmUp.how.consent" = "Accepts the cookie banner of some twenty-five consent tools, and of other banners only when a fixed box about cookies has a button that says exactly \"accept\". New warm-up can also leave banners alone.";
"help.warmUp.several" = "Several profiles and a schedule";
"help.warmUp.several.queue" = "The queue warms as many profiles at once as this Mac allows (or 1–8, set on its bar); it can be paused, a profile taken off or put next, and the failed ones run again.";
"help.warmUp.several.schedule" = "Repeat in New warm-up warms the chosen profiles by themselves every few hours while the app is unlocked, with a random shift; a profile you have open is left alone and tried again ten minutes later.";
"help.warmUp.several.last" = "The Warm-up section lists every profile by its state — warmed and when, never warmed, needs attention — and keeps each profile's last 50 runs with their reports. The Profiles list marks a warmed profile.";
"help.warmUp.know" = "Good to know";
"help.warmUp.know.stop" = "Three pages in a row that do not load end a run as \"the proxy does not answer\"; a page with a CAPTCHA, or a sign-in or payment page, is left at once. The report names each.";
"help.warmUp.know.limits" = "It does not answer CAPTCHAs, sign in or fill in forms; a site that studies behaviour closely can still tell a robot.";
"help.warmUp.know.local" = "The plan, the schedule, the history and your own lists stay on this Mac: they are not synced and not in a profile export.";
"help.topic.codes" = "One-Time Codes";
"help.codes.intro" = "Lumen makes the one-time codes of two-step sign-in itself (the ones an authenticator app on a phone usually shows). A code is kept in the profile beside the password: encrypted the same way, and synced with it.";
"help.codes.add" = "Adding one";
"help.codes.step.site" = "On the site, turn two-step sign-in on and choose an authenticator app. The site shows a QR code and the secret as text.";
"help.codes.step.open" = "In Lumen, open the profile's Passwords and Codes, select the site's login and press Add a One-Time Code… — or Add Password, if there is no login yet.";
"help.codes.step.secret" = "Under One-time code, paste the secret or the otpauth:// link. Or use the QR code: press ⌃⇧⌘4, drag over it on the screen and click Paste from Clipboard — or choose the picture's file, or drop the picture in.";
"help.codes.step.save" = "Save. The site asks for a code to confirm: it is already shown in the login.";
"help.codes.use" = "Using it";
"help.codes.use.copy" = "In Passwords and Codes, a login shows its current code and how many seconds it has left. One click on the code copies it.";
"help.codes.use.fill" = "When a page asks for a code, the site's logins that have one are listed under the field: choose one and its code is filled in. As with passwords, and in Safari's window too.";
"help.codes.use.only" = "A login can be a code alone, with no password.";
"help.codes.know" = "Worth knowing";
"help.codes.know.screen" = "Lumen does not capture the screen itself: macOS asks for the Screen Recording permission for that. A QR code reaches Lumen through the clipboard, a file or a drop.";
"help.codes.know.kinds" = "Time-based codes (TOTP) are supported: SHA-1, SHA-256 and SHA-512, 6 to 8 digits. Counter-based codes (HOTP) and an authenticator app's export of several accounts at once are not.";
"help.codes.know.clock" = "A code depends on the time: the Mac's clock must be right.";
"help.codes.know.older" = "A profile that holds at least one code is read only by versions of Lumen that have one-time codes. An older version on another Mac does not open that profile's passwords until it is updated, so that it cannot erase the codes.";
"help.codes.backup" = "A code in Lumen stands in for the phone as the second factor only while you can open the vault. Keep the backup codes the site gives you.";
"help.topic.check" = "Profile Check";
"help.topic.webdriver" = "Selenium and WebDriver";
"help.check.intro" = "One button compares what a profile's pages see with where the profile exits to the internet — what anti-fraud systems compare first. The result is “All in order” or “Things to look at”, with each explained and, where possible, a button that fixes it.";
"help.check.run" = "Running it";
"help.check.step.open" = "Select the profile and press Check the profile in the profile panel on the right — or Check the Profile… in its ⋯ menu, or type Check in the command palette (⌘K).";
"help.check.step.press" = "Press Check the Profile. A stopped profile is started; a measuring page opens in its window for a few seconds.";
"help.check.step.read" = "Read the verdict and the rows under it: a green tick is in order, a yellow triangle is something to look at, a grey question mark could not be checked, and says why.";
"help.check.step.fix" = "A finding the settings can put right has a button. It changes the profile's settings at once; then press Restart and Check Again.";
"help.check.what" = "What is checked";
"help.check.what.proxy" = "Proxy and address — whether the proxy answers, and which address and country sites see.";
"help.check.what.timeZone" = "Time zone — whether the pages' time is the exit's.";
"help.check.what.language" = "Language — whether the pages' language is usual for the exit's country.";
"help.check.what.geolocation" = "Geolocation — when a fixed place is set, how far it is from the exit.";
"help.check.geolocation.engine" = "A fixed place is chosen on the map in the profile's settings (an address, the proxy's city, or a click). In Safari's window the engine itself gives it to sites, as real Safari does: nothing is added to the page.";
"help.check.what.webRTC" = "WebRTC — off, through the proxy, or able to show the real address.";
"help.check.what.dns" = "DNS — whether sites' names are looked up by the proxy, not by this Mac.";
"help.check.what.engine" = "Safari version — whether the User-Agent names the version of the engine that draws the page.";
"help.check.what.window" = "Window and screen — whether the window fits the screen and opens at the size asked for.";
"help.check.know" = "Worth knowing";
"help.check.local" = "The check runs on this Mac. One request leaves it — the way the profile's pages go — to a service that names the exit's address and country. The profile makes the same request at every start; nothing of the profile is in it.";
"help.check.know.restart" = "A fix changes the settings, and the running profile has the old ones. The result shows after a restart.";
"help.check.know.unknown" = "“Not checked” is not a finding: there was nothing to compare with (for example, the service did not name the exit's country).";
"help.check.know.dns" = "DNS is checked from how the profile is built: requests go to the proxy by name, DNS prefetching is off, UDP is closed. A real leak test needs an outside service and is not made here.";
"help.check.know.signals" = "The “All signals” tab shows everything the page measured, value by value, and can compare it with this Mac's Safari.";
"help.webdriver.plan" = "Driving a profile from Selenium is part of the Professional and Team plans, and of the trial. Without it Lumen refuses a new session and says why.";
"help.webdriver.connect" = "Connecting";
"help.webdriver.example" = "An example in Python";
"help.webdriver.know" = "Worth knowing";

