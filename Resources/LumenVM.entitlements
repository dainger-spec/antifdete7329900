<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Contents/MacOS/LumenVM alone: Apple's right to run virtual machines (Virtualization.framework).
	     Nothing else — no keychain group, no network extension's right, no relaxation of the hardened
	     runtime (docs/VM.md). -->
	<key>com.apple.security.virtualization</key>
	<true/>
</dict>
</plist>
