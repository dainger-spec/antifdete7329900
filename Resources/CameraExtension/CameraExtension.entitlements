<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A CMIO Camera Extension delivered as a system extension. Needs a provisioning profile of the
	     team with the matching capability. It captures nothing and opens no connection: sandboxed,
	     with only the shared app group it reads its config through, and the team identifiers.
	     scripts/build-app.sh refuses an entitlements file that grants it a network connection. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(APP_GROUP)</string>
	</array>
	<key>com.apple.application-identifier</key>
	<string>$(TEAM_ID).$(EXTENSION_ID)</string>
	<key>com.apple.developer.team-identifier</key>
	<string>$(TEAM_ID)</string>
</dict>
</plist>
