      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Session"
          }
        }
      }
    },
    "Удалить сессию со всеми её данными?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the session with all its data?"
          }
        }
      }
    },
    "Удаляются куки, хранилище, кэш, вкладки и история этой сессии.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes the session’s cookies, storage, cache, tabs and history."
          }
        }
      }
    },
    "Укажите порт: адрес:порт.": {
      "localizations": {
        "en": {
