    "Тип": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type"
          }
        }
      }
    },
    "Только строка браузера, часовой пояс и язык": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the browser string, time zone and language"
          }
        }
      }
    },
    "У адреса прокси нет пути после порта.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A proxy’s address has no path after the port."
          }
        }
      }
    },
    "У каждой сессии свои куки, хранилище сайтов, вкладки, история и прокси.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each session has its own cookies, site storage, tabs, history and proxy."
          }
        }
      }
    },
    "У сессии свои куки, хранилище сайтов, вкладки и история.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A session has its own cookies, site storage, tabs and history."
          }
        }
      }
    },
    "У этого аккаунта было много неудачных попыток входа, поэтому мы отправили код на его почту. Введите код из письма.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account had many failed sign-in attempts, so we sent a code to its email. Enter the code from the email."
          }
        }
      }
    },
    "Удалить": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        }
      }
    },
    "Удалить прокси": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Proxy"
          }
        }
      }
    },
    "Удалить прокси «%@»?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the proxy “%@”?"
          }
        }
      }
