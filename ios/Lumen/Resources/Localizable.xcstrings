{
  "sourceLanguage": "ru",
  "strings": {
    " Повторите через %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Try again in %@."
          }
        }
      }
    },
    " до %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " until %@"
          }
        }
      }
    },
    "%@ Сессия работала через прокси — без него она не откроется, чтобы сайты не увидели настоящий адрес iPhone. Данные сессии сохранены.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ This session worked through a proxy, so it won't open without one — sites must not see the iPhone's real address. The session's data is kept."
          }
        }
      }
    },
    "%@ дн.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ d"
          }
        }
      }
    },
    "%@ из %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of %@"
          }
        }
      }
    },
    "%@ мин": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ min"
          }
        }
      }
    },
    "%@ ч": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ h"
          }
        }
      }
    },
    "7 дней бесплатно": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "7 days free"
          }
        }
      }
    },
    "Lumen давно не получал ответа сервера. Прокси недоступны, пока сервер Lumen не ответит.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumen has not heard from its server for a long time. Proxies are unavailable until the Lumen server answers."
          }
        }
      }
    },
    "UDP: не проверен": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UDP: not checked"
          }
        }
      }
    },
    "UDP: не умеет": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UDP: no"
          }
        }
      }
    },
    "UDP: проверяется": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UDP: checking"
          }
        }
      }
    },
    "UDP: умеет": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UDP: yes"
          }
        }
      }
    },
    "__language": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "en"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ru"
          }
        }
      }
    },
    "Адрес или запрос": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address or search"
          }
        }
      }
    },
    "Аккаунт": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        }
      }
    },
    "Аккаунт Lumen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumen Account"
          }
        }
      }
    },
    "Аккаунт Lumen — тот же, что в Lumen для Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Lumen account is the same one as in Lumen for Mac."
          }
        }
      }
    },
    "Аккаунт заблокирован": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account blocked"
          }
        }
      }
    },
    "Аккаунт заблокирован, напишите в поддержку.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is blocked. Contact support."
          }
        }
      }
    },
    "Аккаунт удаляется. Отменить удаление можно на сайте.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is being deleted. You can cancel the deletion on the website."
          }
        }
      }
    },
    "Без прокси": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No proxy"
          }
        }
      }
    },
    "Бесплатный": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free"
          }
        }
      }
    },
    "Браузер": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser"
          }
        }
      }
    },
    "Браузер и поиск": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser and Search"
          }
        }
      }
    },
    "В адресе прокси не бывает пробелов.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A proxy’s address has no spaces."
          }
        }
      }
    },
    "В бесплатном доступе прокси нет": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free level has no proxies"
          }
        }
      }
    },
    "В вашем тарифе нет прокси.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan has no proxies."
          }
        }
      }
    },
    "В вашем тарифе сайты на iPhone не открываются.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan does not open sites on iPhone."
          }
        }
      }
    },
    "Введите адрес или запрос.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an address or a search."
          }
        }
      }
    },
    "Введите адрес прокси.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the proxy’s address."
          }
        }
      }
    },
    "Ввести пароль заново": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the password again"
          }
        }
      }
    },
    "Вид прокси «%@» не поддерживается: подойдут socks5 и http.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The proxy type “%@” is not supported: use socks5 or http."
          }
        }
      }
    },
    "Вкладки: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs: %@"
          }
        }
      }
    },
    "Войдите в аккаунт Lumen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to your Lumen account."
          }
        }
      }
    },
    "Войдите, чтобы включить свой тариф.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to turn on your plan."
          }
        }
      }
    },
    "Войти": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign In"
          }
        }
      }
    },
    "Вперёд": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forward"
          }
        }
      }
    },
    "Все возможности (проверочная сборка)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything (test build)"
          }
        }
      }
    },
    "Вход": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign In"
          }
        }
      }
    },
    "Вход не выполнен": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not signed in"
          }
        }
      }
    },
    "Вчера": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday"
          }
        }
      }
    },
    "Выбрать прокси": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a Proxy"
          }
        }
      }
    },
    "Выйти": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign Out"
          }
        }
      }
    },
    "Выйти из аккаунта на этом iPhone?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out of the account on this iPhone?"
          }
        }
      }
    },
    "Выкл": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        }
      }
    },
    "Выкл — сайт не получит значение. Настоящий — как у этого iPhone. Шум — своё значение у этой сессии, одно и то же при каждом запуске.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off — the site gets no value. Real — as on this iPhone. Noise — a value of this session's own, the same on every launch."
          }
        }
      }
    },
    "Готово": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "Данные сессии сохранены.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session's data is kept."
          }
        }
      }
    },
    "Данные синхронизации на сервере изменились. Синхронизируйте ещё раз.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sync data on the server changed. Sync again."
          }
        }
      }
    },
    "Добавить прокси": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Proxy"
          }
        }
      }
    },
    "Добавьте HTTP или SOCKS5 — строкой, как его выдал провайдер.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an HTTP or SOCKS5 proxy — as one line, the way your provider gave it."
          }
        }
      }
    },
    "Ещё не открывали": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never opened"
          }
        }
      }
    },
    "Забыли пароль?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forgot password?"
          }
        }
      }
    },
    "Забыть хранилище": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget the Vault"
          }
        }
      }
    },
    "Забыть хранилище на этом iPhone?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget the vault on this iPhone?"
          }
        }
      }
    },
    "Забыть — значит отключить этот iPhone от хранилища. Сессии на Mac останутся.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forgetting disconnects this iPhone from the vault. The sessions on the Mac stay."
          }
        }
      }
    },
    "Задавать": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set By"
          }
        }
      }
    },
    "Задайте код-пароль iPhone в Настройках: без него ключ хранилища не сохранить.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set an iPhone passcode in Settings: without one the vault's key cannot be kept."
          }
        }
      }
    },
    "Закрыть вкладку": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close Tab"
          }
        }
      }
    },
    "Заперта": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked"
          }
        }
      }
    },
    "Заперта: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked: %@"
          }
        }
      }
    },
    "Заперта: без прокси не откроется": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked: won't open without a proxy"
          }
        }
      }
    },
    "Звук": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio"
          }
        }
      }
    },
    "Здесь один прокси: одна строка.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One proxy goes here: a single line."
          }
        }
      }
    },
    "Здесь появятся страницы, открытые в этой сессии.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages opened in this session will appear here."
          }
        }
      }
    },
    "Изменить": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit"
          }
        }
      }
    },
    "Имя": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        }
      }
    },
    "Имя, описание, метка, прокси": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name, description, tag, proxy"
          }
        }
      }
    },
    "История": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History"
          }
        }
      }
    },
    "История пуста": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No history"
          }
        }
      }
    },
    "К этой лицензии уже подключено наибольшее число iPhone%@. Отключите один из них в кабинете на сайте и войдите снова.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This license already has the largest number of iPhones connected%@. Disconnect one of them in your account on the website and sign in again."
          }
        }
      }
    },
    "Как Safari этого iPhone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same as this iPhone’s Safari"
          }
        }
      }
    },
    "Как у устройства": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same as the device"
          }
        }
      }
    },
    "Канвас": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Canvas"
          }
        }
      }
    },
    "Канвас, WebGL и звук свои и постоянные": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its own canvas, WebGL and audio, the same every time"
          }
        }
      }
    },
    "Канвас, WebGL и звук — по отдельности": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Canvas, WebGL and audio, each set apart"
          }
        }
      }
    },
    "Ключ хранилища удалится с iPhone. Сессии с Mac останутся в списке; чтобы синхронизировать снова, понадобится мастер-пароль.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault key will be removed from the iPhone. Sessions from the Mac stay in the list; to sync again you'll need the master password."
          }
        }
      }
    },
    "Код в этой попытке больше не отправить. Письма нет — проверьте «Спам».": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code can’t be sent again in this attempt. No email? Check your spam folder."
          }
        }
      }
    },
    "Код из письма": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code from the email"
          }
        }
      }
    },
    "Код неверный или устарел.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is wrong or has expired."
          }
        }
      }
    },
    "Код этого iPhone в кабинете: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone’s code in your account: %@"
          }
        }
      }
    },
    "Команда": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Team"
          }
        }
      }
    },
    "Куки обновлены: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookies updated: %@"
          }
        }
      }
    },
    "Куки, хранилище сайтов, вкладки и история «%@» будут удалены. Это нельзя отменить.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cookies, site storage, tabs and history of “%@” will be deleted. This can't be undone."
          }
        }
      }
    },
    "Личный": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal"
          }
        }
      }
    },
    "Мастер-пароль": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Master password"
          }
        }
      }
    },
    "Мастер-пароль изменился на Mac. Введите новый.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The master password changed on your Mac. Enter the new one."
          }
        }
      }
    },
    "Мастер-пароль — тот же, что у хранилища Lumen на Mac. Он нужен один раз, дальше — Face ID.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The master password is the one of the Lumen vault on your Mac. It's needed once; after that, Face ID."
          }
        }
      }
    },
    "Метки через запятую": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags, comma-separated"
          }
        }
      }
    },
    "На этом iPhone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this iPhone"
          }
        }
      }
    },
    "На этом iPhone можно держать не больше %@ профилей.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone can keep no more than %@ profiles."
          }
        }
      }
    },
    "Назад": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        }
      }
    },
    "Название": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        }
      }
    },
    "Настоящий": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real"
          }
        }
      }
    },
    "Настройки сессии": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session Settings"
          }
        }
      }
    },
    "Не отвечает": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Responding"
          }
        }
      }
    },
    "Не проверен": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not checked"
          }
        }
